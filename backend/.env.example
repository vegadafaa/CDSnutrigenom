# NutriGen-CDS Backend Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai

# Server
PORT=3000

# JWT Secret (ganti dengan string acak yang panjang dan aman)
JWT_SECRET=nutrigen_jwt_super_secret_change_this_in_production

# Database (PostgreSQL - untuk production)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nutrigen_cds
# DB_USER=postgres
# DB_PASSWORD=your_secure_db_password
